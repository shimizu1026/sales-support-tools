# ポートフォリオ・デモ用 .env（このファイルをコピーして .env にリネーム）



# デモモード（Supabase 不要・ローカル CRM）

SALES_DEMO_MODE=1



# デモDB（seed_demo_db.py で生成）

NENKAN_DB_PATH=demo/demo_companies.db

DEMO_CRM_DB_PATH=demo/demo_crm.db



# Supabase（SALES_DEMO_MODE=1 なら未設定でOK。CRM をクラウドで見せる場合のみ）

# SUPABASE_URL=https://xxxxxxxx.supabase.co

# SUPABASE_KEY=your_demo_anon_key



# Web取得の AI（未設定なら正規表現フォールバックのみ）

SCRAPER_AI_PROVIDER=ollama

LOCAL_LLM_URL=http://127.0.0.1:11434/v1

LOCAL_LLM_API_KEY=ollama

LOCAL_LLM_MODEL=llama3.1:8b



SCRAPER_TIMEOUT_SEC=120

